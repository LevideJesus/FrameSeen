@FrameSeen_HostAddress = http://localhost:5066

### GET SERIE BY ID 
GET {{FrameSeen_HostAddress}}/api/series/search?q=stranger
Accept: application/json

### ADD A SERIE

POST {{FrameSeen_HostAddress}}/api/series/
Accept: application/json
Content-Type: application/json

{
  
  "name": "Stranger Things",

}

### UPDATE A SERIE
POST {{FrameSeen_HostAddress}}/api/series/
Accept: application/json
Content-Type: application/json

{
  "name": "Game of Throwns",
}
### ADD
POST {{FrameSeen_HostAddress}}/api/series/
